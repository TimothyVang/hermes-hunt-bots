+  if (typeof value !== 'string' || !value || value.startsWith('/') || value.includes('\\') || /[<>:"|?*\x00-\x1f]/.test(value)) return false
+  return value.split('/').every(part => part && part !== '.' && part !== '..' && !part.endsWith('.') && !part.endsWith(' ') && !WINDOWS_RESERVED.test(part))
