+@pytest.mark.parametrize("outcome, previous_mode", [
+    ("success", "1"), ("failure", None), ("interrupt", "0"),
+])
+def test_oneshot_restores_caller_modes_logging_and_delivery(offline_runtime, monkeypatch, outcome, previous_mode):
+    import logging
+    import os
+    import hermes_cli.oneshot as oneshot
+    from gateway import session_context
+
+    names = ("HERMES_YOLO_MODE", "HERMES_ACCEPT_HOOKS", "HERMES_SINGLE_QUERY_SESSION")
+    for name in names:
+        monkeypatch.setenv(name, "0")
+    if previous_mode is None:
+        monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION")
+    else:
+        monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", previous_mode)
+    before = {name: os.environ.get(name) for name in names}
+    logging_level = logging.root.manager.disable
+    delivery_token = session_context._SESSION_ASYNC_DELIVERY.set(True)
+    observed = []
+
+    def synthetic_turn(*_args, **_kwargs):
+        assert all(os.environ[name] == "1" for name in names)
+        assert not session_context.async_delivery_supported()
+        assert logging.root.manager.disable == logging.CRITICAL
+        observed.append(True)
+        if outcome == "failure":
+            raise RuntimeError("synthetic failure before inference")
+        if outcome == "interrupt":
+            raise KeyboardInterrupt()
+        return "synthetic unit-test result", {}
+
+    monkeypatch.setattr(oneshot, "_run_agent", synthetic_turn)
+    try:
+        assert session_context.async_delivery_supported()
+        if outcome == "interrupt":
+            with pytest.raises(KeyboardInterrupt):
+                oneshot.run_oneshot("Synthetic state-scope check")
+        else:
+            assert oneshot.run_oneshot("Synthetic state-scope check") == (0 if outcome == "success" else 1)
+        assert observed == [True]
+        assert {name: os.environ.get(name) for name in names} == before
+        assert session_context.async_delivery_supported()
+        assert logging.root.manager.disable == logging_level
+    finally:
+        session_context._SESSION_ASYNC_DELIVERY.reset(delivery_token)
+
+
+@pytest.mark.parametrize("cap", [[], ["read_file"], None])
+def test_acp_persist_restore_and_fork_preserve_effective_cap(offline_runtime, cap):
+    from acp_adapter.session import SessionManager
+
+    db = SessionDB(db_path=offline_runtime / "acp-state.db")
+    db.create_session(
+        "existing-acp", source="acp", model="synthetic-offline-policy-check",
+        model_config={"allowed_tool_names": cap, "cwd": str(offline_runtime)},
+    )
+    states = []
+    try:
+        manager = SessionManager(db=db)
+        first = manager.get_session("existing-acp")
+        assert first is not None
+        states.append(first)
+        assert_effective_authority(first.agent, cap)
+        manager.save_session(first.session_id)
+        stored = json.loads(db.get_session(first.session_id)["model_config"])
+        assert stored["allowed_tool_names"] == sorted(first.agent.allowed_tool_names)
+
+        restored_manager = SessionManager(db=db)
+        restored = restored_manager.get_session(first.session_id)
+        assert restored is not None
+        states.append(restored)
+        assert_effective_authority(restored.agent, cap)
+        fork = restored_manager.fork_session(restored.session_id, cwd=str(offline_runtime))
+        assert fork is not None and fork.session_id != restored.session_id
+        states.append(fork)
+        assert_effective_authority(fork.agent, cap)
+    finally:
+        for state in states:
+            state.agent.close()
+        db.close()
+
+
