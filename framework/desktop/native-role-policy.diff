+"""Exact-tool authority survives compression and fork publication in the SQLite store."""
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from hermes_state_runtime import RuntimeStoreError
+
+
+@pytest.mark.parametrize('cap', [['read', 'write'], [], None])
+def test_compression_branch_and_reset_publish_parent_tool_cap(tmp_path, cap):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        for kind in ('compression', 'branch', 'reset'):
+            parent = f'parent-{kind}'
+            db.create_session(parent, source='cli', model_config={'allowed_tool_names': cap})
+            if kind == 'compression':
+                child = f'child-{kind}'
+                db.publish_compression_child(parent_session_id=parent, child_session_id=child,
+                    source='cli', messages=[{'role': 'user', 'content': 'summary'}],
+                    model_config={'_compressed_from': parent}, require_compression_lease=False)
+            else:
+                child = f'child-{kind}'
+                marker = '_branched_from' if kind == 'branch' else '_reset_from'
+                def publish(conn):
+                    row = conn.execute('SELECT * FROM sessions WHERE id=?', (parent,)).fetchone()
+                    db._publish_child_session_row(conn, row, parent_session_id=parent,
+                        child_session_id=child, source='cli', model='model',
+                        model_config={marker: parent}, system_prompt=None, cwd=None, profile_name=None)
+                db._execute_write(publish)
+            stored = json.loads(db.get_session(child)['model_config'])
+            assert stored['allowed_tool_names'] == cap
+            assert stored[{'compression': '_compressed_from', 'branch': '_branched_from',
+                          'reset': '_reset_from'}[kind]] == parent
+            if kind == 'reset':
+                constructor_cap = None if cap is None else ['read']
+                db.create_session(child, source='cli', model_config={
+                    'allowed_tool_names': constructor_cap,
+                    'reasoning_config': {'effort': 'high'},
+                })
+                reset_config = json.loads(db.get_session(child)['model_config'])
+                assert reset_config['reasoning_config'] == {'effort': 'high'}
+                assert reset_config['allowed_tool_names'] == (
+                    None if cap is None else (['read'] if cap else []))
+    finally:
+        db.close()
+
+
+def test_compression_publication_rejects_malformed_parent_authority_atomically(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        db.create_session('parent', source='cli')
+        db._execute_write(lambda conn: conn.execute(
+            'UPDATE sessions SET model_config=? WHERE id=?',
+            ('{\"allowed_tool_names\":\"not-a-list\"}', 'parent')))
+        with pytest.raises(RuntimeStoreError):
+            db.publish_compression_child(parent_session_id='parent', child_session_id='child',
+                source='cli', messages=[{'role': 'user', 'content': 'summary'}],
+                model_config={'_compressed_from': 'parent'}, require_compression_lease=False)
+        assert db.get_session('child') is None
+        assert db.get_session('parent')['ended_at'] is None
+    finally:
+        db.close()
+
+
+def test_pending_parent_authority_refuses_compression_publication_atomically(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        db.create_session('parent', source='cli', model_config={'_tool_policy_pending': True})
+        with pytest.raises(RuntimeStoreError):
+            db.publish_compression_child(parent_session_id='parent', child_session_id='child',
+                source='cli', messages=[{'role': 'user', 'content': 'summary'}],
+                model_config={'_compressed_from': 'parent', 'allowed_tool_names': []},
+                require_compression_lease=False)
+        assert db.get_session('child') is None
+        assert db.get_session('parent')['ended_at'] is None
+    finally:
+        db.close()
