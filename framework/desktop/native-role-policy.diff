+            state, [SimpleNamespace(name="synthetic", url="http://127.0.0.1:1/unused", headers=[])],
+        ))
+        assert_effective_authority(state.agent, cap)
+    finally:
+        if state is not None:
+            state.agent.close()
+        db.close()
