+
+    class ObservedBeforeInference(Exception):
+        pass
+
+    observed = []
+
+    def observe_actual_agent(self, *_args, **_kwargs):
+        assert self.session_id == "existing-oneshot"
+        assert_effective_authority(self, cap)
+        observed.append(True)
+        raise ObservedBeforeInference()
+
+    # Exercise the real runner and constructor, then stop before any model request.
+    monkeypatch.setattr(AIAgent, "run_conversation", observe_actual_agent)
