diff --git a/agent/tool_policy.py b/agent/tool_policy.py
new file mode 100644
index 0000000..d94bae0
--- /dev/null
+++ b/agent/tool_policy.py
@@ -0,0 +1,89 @@
+"""Small per-agent policy for constraining advertised and invoked tools."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+
+def normalize_tool_names(value):
+    """Return an immutable exact-name set, or empty on malformed restrictions."""
+    if not isinstance(value, list) or any(not isinstance(name, str) or not name for name in value):
+        return frozenset()
+    return frozenset(value)
+
+
+def resolve_allowed_tool_names(config, constructor_cap=None, *, config_read_failed=False):
+    """Resolve config policy and optional constructor cap; None means legacy unrestricted."""
+    if config_read_failed:
+        return frozenset()
+    if not isinstance(config, Mapping) or "agent" not in config:
+        configured_present = False
+        section = {}
+    else:
+        section = config["agent"]
+        configured_present = True
+    if configured_present and not isinstance(section, Mapping):
+        allowed = frozenset()
+    elif isinstance(section, Mapping) and "allowed_tool_names" in section:
+        allowed = normalize_tool_names(section["allowed_tool_names"])
+    else:
+        allowed = None
+    if constructor_cap is not None:
+        cap = normalize_tool_names(constructor_cap)
+        allowed = cap if allowed is None else allowed & cap
+    return allowed
+
+
+def effective_tool_cap(frozen_config, current_config):
+    """Intersect a persisted session cap with the current profile restriction."""
+    frozen = resolve_allowed_tool_names(frozen_config)
+    current = resolve_allowed_tool_names(current_config)
+    if frozen is None:
+        return current
+    return frozen if current is None else frozen & current
+
+
+def filter_tool_definitions(tool_defs, allowed_tool_names):
+    if allowed_tool_names is None:
+        return tool_defs
+    return [
+        td for td in (tool_defs or [])
+        if isinstance(td, dict)
+        and isinstance(td.get("function"), dict)
+        and td["function"].get("name") in allowed_tool_names
+    ]
+
+
+def allows_tool(allowed_tool_names, name):
+    return allowed_tool_names is None or name in allowed_tool_names
+
+
+def _stored_session_tool_cap(row: dict | None) -> list[str] | None:
+    """Tool authority from one persisted row: missing/unknown and pending rows fail closed."""
+    if not row:
+        return []
+    raw = row.get("model_config")
+    if raw in (None, ""):
+        model_config = {}
+    elif isinstance(raw, dict):
+        model_config = raw
+    elif isinstance(raw, str):
+        import json
+        try:
+            model_config = json.loads(raw)
+        except (TypeError, ValueError):
+            return []
+        if not isinstance(model_config, dict):
+            return []
+    else:
+        return []
+    if "_tool_policy_pending" in model_config:
+        return []
+    if "allowed_tool_names" not in model_config:
+        return None  # A readable pre-policy row is genuinely unrestricted.
+    names = model_config["allowed_tool_names"]
+    if names is None:
+        return None
+    if not isinstance(names, list) or any(not isinstance(name, str) or not name for name in names):
+        return []
+    return names
