+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def offline_runtime(tmp_path, monkeypatch):
+    import gateway.run as gateway_run
+    import hermes_cli.runtime_provider as runtime_provider
+
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    config = {
+        "model": {"default": "synthetic-offline-policy-check", "provider": "custom"},
+        "agent": {"allowed_tool_names": ["read_file", "terminal"], "max_turns": 1},
+        "platform_toolsets": {
+            "api_server": ["no_mcp", "file", "terminal"],
+            "cli": ["no_mcp", "file", "terminal"],
+            "acp": ["no_mcp", "file", "terminal"],
+        },
+        "fallback_providers": [],
+    }
+    (home / "config.yaml").write_text(json.dumps(config), encoding="utf-8")
+    runtime = {
+        "provider": "custom", "base_url": "http://127.0.0.1:1/v1",
+        "api_key": "synthetic-not-a-credential", "credential_pool": None,
+    }
+    monkeypatch.setattr(gateway_run, "_load_gateway_config", lambda: config)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: dict(runtime))
+    monkeypatch.setattr(gateway_run, "_resolve_gateway_model", lambda: "synthetic-offline-policy-check")
+    monkeypatch.setattr(gateway_run, "_current_max_iterations", lambda: 1)
+    monkeypatch.setattr(runtime_provider, "resolve_runtime_provider", lambda **_kwargs: dict(runtime))
+    monkeypatch.setattr("hermes_cli.mcp_startup.ensure_mcp_discovery_before_agent_build", lambda **_kwargs: None)
+    return home
+
+
+def assert_effective_authority(agent, cap):
+    expected = {"read_file", "terminal"} if cap is None else set(cap)
+    assert agent.allowed_tool_names == frozenset(expected)
+    if cap is None:
+        assert "read_file" in agent.valid_tool_names
+    else:
+        assert agent.valid_tool_names == expected
+        result = json.loads(invoke_tool(agent, "terminal", {"command": "exit 77"}, "policy-consumer"))
+        assert "not allowed" in result["error"]
