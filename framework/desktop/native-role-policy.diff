+"""Synthetic-only subprocess coverage for the startup-isolated projection.
+
+The child denies writes/network/process creation and unsafe imports before the
+native module is loaded. Fixture snapshots also detect persistent side effects.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+SOURCE = Path(__file__).resolve().parents[2]
+MODEL = "synthetic/model-a"
+CHILD = r'''
+import importlib.abc, os, runpy, sys
+source, root, deny_read, *args = sys.argv[1:]
+sys.path.insert(0, source)
+violations = []
+blocked = ('hermes_bootstrap', 'hermes_cli.main', 'hermes_cli.config',
+           'hermes_cli.config_effective', 'hermes_cli.env_loader',
+           'hermes_cli.auth', 'hermes_logging', 'pm', 'agent', 'gateway', 'tools')
+class DenyImports(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if any(fullname == name or fullname.startswith(name + '.') for name in blocked):
+            violations.append('import')
+            raise RuntimeError('forbidden import')
+sys.meta_path.insert(0, DenyImports())
+allowed_config = os.path.normcase(os.path.join(root, 'profiles', 'synthetic', 'config.yaml'))
+def audit(event, args):
+    if event == 'open':
+        path, mode, flags = args
+        if (isinstance(mode, str) and any(c in mode for c in 'wax+')) or flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
+            violations.append('write')
+            raise RuntimeError('forbidden write')
+        if isinstance(path, (str, bytes)):
+            name = os.path.normcase(os.path.abspath(os.fsdecode(path)))
+            fixture = os.path.normcase(os.path.abspath(root))
+            if (name == fixture or name.startswith(fixture + os.sep)) and name != allowed_config:
+                violations.append('fixture read')
+                raise RuntimeError('forbidden fixture read')
+            if deny_read == 'yes' and name == allowed_config:
+                raise PermissionError('SYNTHETIC-DO-NOT-READ')
+    if (event.startswith('socket.') or event.startswith('subprocess.')
+            or event in ('os.system', 'os.mkdir', 'os.remove', 'os.rename', 'os.rmdir',
+                         'os.chmod', 'os.chown', 'os.link', 'os.symlink', 'os.utime',
+                         'os.truncate', 'os.startfile', 'os.posix_spawn', 'os.fork')):
+        violations.append('side effect')
+        raise RuntimeError('forbidden side effect')
+sys.addaudithook(audit)
+# Prove the denials are armed, rather than trusting an unused hook.
+for probe in ('write', 'network', 'import'):
+    try:
+        if probe == 'write':
+            open(os.path.join(root, 'forbidden'), 'w')
+        elif probe == 'network':
+            import socket
+            socket.socket()
+        else:
+            __import__('hermes_bootstrap')
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError('denial not active')
+violations.clear()
+sys.argv = ['hermes_cli.config_model_projection', '--root', root,
+            '--profile', 'synthetic', '--expected-model', 'synthetic/model-a', *args]
+try:
+    runpy.run_module('hermes_cli.config_model_projection', run_name='__main__')
+finally:
+    if violations:
+        raise AssertionError('projection attempted forbidden activity: ' + ','.join(violations))
+'''
+
+
+def snapshot(root):
+    return {
+        str(path.relative_to(root)): (
+            path.lstat().st_mode, path.lstat().st_mtime_ns,
+            hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() and not path.is_symlink() else None,
+        )
+        for path in root.rglob('*')
+    }
+
+
+class ModelProjectionTests(unittest.TestCase):
+    def run_projection(self, payload, *, args=(), setup=None, deny_read=False):
+        with tempfile.TemporaryDirectory(prefix='model-projection-') as directory:
+            root = Path(directory).resolve() / 'native'
+            home = root / 'profiles' / 'synthetic'
+            home.mkdir(parents=True)
+            if payload is not None:
+                (home / 'config.yaml').write_bytes(payload if isinstance(payload, bytes) else payload.encode('utf-8'))
+            for name in ('.env', 'auth.json', 'state.db', 'active_profile'):
+                (home / name).write_text('SYNTHETIC-DO-NOT-READ', encoding='utf-8')
+            if setup:
+                setup(root, home)
+            before = snapshot(root)
+            env = {'PATH': os.defpath, 'HERMES_HOME': str(root / 'wrong-home'),
+                   'MODEL_SENTINEL': MODEL}
+            for name in ('SystemRoot', 'WINDIR'):
+                if name in os.environ:
+                    env[name] = os.environ[name]
+            result = subprocess.run(
+                [sys.executable, '-I', '-B', '-c', CHILD, str(SOURCE), str(root), 'yes' if deny_read else 'no', *args],
+                cwd=directory, env=env, capture_output=True, text=True, encoding='utf-8', timeout=20,
+            )
+            self.assertEqual(snapshot(root), before)
+            self.assertNotIn('SYNTHETIC-DO-NOT-READ', result.stdout + result.stderr)
+            self.assertNotIn(MODEL, result.stdout + result.stderr)
+            self.assertNotIn(str(root), result.stdout + result.stderr)
+            self.assertNotIn(root.as_posix(), result.stdout + result.stderr)
+            return result
+
+    def test_supported_shapes_exact_match_and_nonmatches(self):
+        cases = [
+            (None, 'missing', False), ('{}', 'missing', False),
+            ('model: synthetic/model-a', 'scalar', True),
+            ('model: synthetic/model-b', 'scalar', False),
+            ('model: " synthetic/model-a "', 'scalar', False),
+            ('model: ""', 'scalar', False),
+            ('model: {default: synthetic/model-a, provider: ignored}', 'mapping', True),
+            ('model: {default: synthetic/model-b}', 'mapping', False),
+            ('model: {}', 'mapping', False),
+            ('model: {name: synthetic/model-a}', 'mapping', False),
+            ('model: {model: synthetic/model-a}', 'mapping', False),
+            ('model: {default: {model: synthetic/model-a}}', 'mapping', False),
+            ('model: {default: false, model: synthetic/model-a}', 'mapping', False),
+            ('model: null', 'other', False), ('model: false', 'other', False),
+            ('model: 1', 'other', False), ('model: []', 'other', False),
+            ('model: "${MODEL_SENTINEL}"', 'scalar', False),
+            ('route: &route synthetic/model-a\nmodel: *route', 'scalar', True),
+        ]
+        for payload, shape, match in cases:
+            with self.subTest(payload=payload):
+                result = self.run_projection(payload)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(result.stderr, '')
+                self.assertEqual(json.loads(result.stdout), {'shape': shape, 'expected_model_match': match})
+                self.assertNotIn(MODEL, result.stdout)
+
+    def test_parse_and_root_errors_are_fixed_and_nonrevealing(self):
+        for payload in ('', 'null', 'false', '[]', 'SYNTHETIC-DO-NOT-READ',
+                        'model: [SYNTHETIC-DO-NOT-READ',
+                        'model: synthetic/model-a\nmodel: SYNTHETIC-DO-NOT-READ'):
+            with self.subTest(payload=payload):
+                result = self.run_projection(payload)
+                self.assertEqual(result.returncode, 1)
+                self.assertEqual(result.stdout, '')
+                self.assertTrue(result.stderr.strip())
+
+    def test_invalid_arguments_are_fixed_and_nonrevealing(self):
+        for args in (('--unknown', 'SYNTHETIC-DO-NOT-READ'), ('--profile', '../other'),
+                     ('--root', '.'), ('--expected-model', ''), ('--profile', 'SYNTHETIC'),
+                     ('--root', 'profiles'), ('--root', '~/native')):
+            with self.subTest(args=args):
+                result = self.run_projection('{}', args=args)
+                self.assertEqual(result.returncode, 1)
+                self.assertEqual(result.stdout, '')
+                self.assertTrue(result.stderr.strip())
+
+    def test_unreadable_and_invalid_encoding_are_nonrevealing(self):
+        for payload, denied in (('model: synthetic/model-a', True), (b'model: \xff', False)):
+            result = self.run_projection(payload, deny_read=denied)
+            self.assertEqual(result.returncode, 1)
+            self.assertEqual(result.stdout, '')
+            self.assertTrue(result.stderr.strip())
+
+    def test_deleted_profile_is_refused(self):
+        def setup(root, home):
+            deleted = root / 'profiles' / '.deleted'
+            deleted.mkdir()
+            (deleted / 'synthetic').touch()
+        result = self.run_projection('model: synthetic/model-a', setup=setup)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, '')
+        self.assertTrue(result.stderr.strip())
+
+    def test_symlinked_config_is_refused_without_following(self):
+        def setup(root, home):
+            path = home / 'config.yaml'
+            path.unlink()
+            try:
+                path.symlink_to(home / 'missing-target')
+            except OSError:
+                self.skipTest('symlink creation unavailable')
+        result = self.run_projection('{}', setup=setup)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, '')
+        self.assertTrue(result.stderr.strip())
+
+
+if __name__ == '__main__':
+    unittest.main()
