+"""Value-free persisted-model diagnostic, deliberately separate from CLI startup.
+
+Run with an explicitly selected native Python interpreter, ``-I -B -m
+hermes_cli.config_model_projection --root ROOT --profile PROFILE
+--expected-model MODEL``. Never import main, bootstrap, or the effective loaders:
+those paths can read secrets, repair installations, and write runtime state.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import stat
+import sys
+from pathlib import Path
+
+from hermes_constants import PROFILE_ID_RE, profile_tombstone_path
+
+_ERROR = "Model projection refused; no configuration values were returned."
+
+
+class ProjectionError(ValueError):
+    """An invalid request or unreadable/ambiguous persisted configuration."""
+
+
+class _Parser(argparse.ArgumentParser):
+    def error(self, message):
+        # argparse normally echoes arbitrary rejected arguments.
+        raise ProjectionError(_ERROR)
+
+
+def _ordinary_path(path: Path, *, directory: bool) -> None:
+    """Reject aliases/reparse points, including ancestors, without opening them."""
+    for candidate in (*reversed(path.parents), path):
+        info = candidate.lstat()
+        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0):
+            raise ProjectionError(_ERROR)
+        if candidate != path or directory:
+            if not stat.S_ISDIR(info.st_mode):
+                raise ProjectionError(_ERROR)
+        elif not stat.S_ISREG(info.st_mode):
+            raise ProjectionError(_ERROR)
+
+
+def project_model(root: Path, profile: str, expected_model: str) -> dict[str, object]:
+    """Inspect only the explicit persisted file; not the effective runtime route.
+
+    Only a string model or a mapping's direct string ``default`` is comparable.
+    Legacy mapping aliases/nested defaults intentionally do not certify a match.
+    No canonicalization, environment expansion, overlay or provider lookup occurs.
+    """
+    if (not root.is_absolute() or ".." in root.parts
+            or root.name == "profiles" or root.parent.name == "profiles"
+            or not PROFILE_ID_RE.fullmatch(profile)
+            or not isinstance(expected_model, str) or not expected_model.strip()):
+        raise ProjectionError(_ERROR)
+    _ordinary_path(root, directory=True)
+    home = root if profile == "default" else root / "profiles" / profile
+    _ordinary_path(home, directory=True)
+    if profile != "default" and profile_tombstone_path(home).exists():
+        raise ProjectionError(_ERROR)
+    path = home / "config.yaml"
+    try:
+        _ordinary_path(path, directory=False)
+    except FileNotFoundError:
+        return {"shape": "missing", "expected_model_match": False}
+
+    # Import only the shared parser, never config.py (which has broad imports).
+    import hermes_yaml
+
+    with path.open(encoding="utf-8-sig") as stream:
+        config = hermes_yaml.safe_load(stream)
+    if not isinstance(config, dict):
+        raise ProjectionError(_ERROR)
+    if "model" not in config:
+        return {"shape": "missing", "expected_model_match": False}
+    model = config["model"]
+    if isinstance(model, str):
+        shape, value = "scalar", model
+    elif isinstance(model, dict):
+        shape, value = "mapping", model.get("default")
+    else:
+        shape, value = "other", None
+    return {"shape": shape, "expected_model_match": isinstance(value, str) and value == expected_model}
+
+
+def main(argv=None) -> int:
+    parser = _Parser(description="Project persisted model shape and exact expected-model match only.", allow_abbrev=False)
+    parser.add_argument("--root", required=True, type=Path, help="Explicit absolute native root; no environment or sticky default.")
+    parser.add_argument("--profile", required=True, help="Exact profile ID, or default for the root profile.")
+    parser.add_argument("--expected-model", required=True, help="Reviewed nonsecret model ID to compare exactly.")
+    try:
+        args = parser.parse_args(argv)
+        result = project_model(args.root, args.profile, args.expected_model)
+    except Exception:
+        # YAML diagnostics and OS errors can contain file data or sensitive paths.
+        print(_ERROR, file=sys.stderr)
+        return 1
+    print(json.dumps(result, separators=(",", ":")))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
